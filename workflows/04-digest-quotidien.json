    {
      "parameters": {
        "jsCode": "// Échappe les caractères spéciaux du HTML de Telegram\nconst e = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst annonces = $input.all().map(item => item.json);\n\n// 1. Un bloc de texte par annonce, avec un titre à chaque nouvelle catégorie\nconst blocs = [];\nlet categorieCourante = null;\nfor (const a of annonces) {\n  let bloc = '';\n  if (a.categorie !== categorieCourante) {\n    categorieCourante = a.categorie;\n    bloc += `\\n<b>${e(a.categorie)}</b>\\n`;\n  }\n  bloc += `\\n<b>${e(a.source)}</b> — <a href=\"${e(a.lien)}\">${e(a.titre)}</a>`;\n  if (a.resume) bloc += `\\n${e(a.resume)}`;\n  if (a.notion_a_retenir) bloc += `\\nÀ retenir : <i>${e(a.notion_a_retenir)}</i>`;\n  blocs.push(bloc + '\\n');\n}\n\n// 2. Regrouper les blocs en messages de moins de 3 800 caractères\nconst messages = [];\nlet message = `<b>Les nouveautés du jour</b> (${annonces.length})\\n`;\nfor (const bloc of blocs) {\n  if ((message + bloc).length > 3800) {\n    messages.push(message);\n    message = '';\n  }\n  message += bloc;\n}\nmessages.push(message);\n\n// 3. Un item par message : le nœud Telegram enverra donc un message par item\nreturn messages.map(texte => ({ json: { texte } }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1152,
        -464
      ],
