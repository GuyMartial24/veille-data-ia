      "parameters": {
        "jsCode": "// Chaque item contient un message (la notion, puis les nouveautés)\nconst separateur = '<hr style=\"border:none; border-top:1px solid #ddd; margin:24px 0\">';\nconst corps = $input.all()\n  .map(item => item.json.texte.replace(/\\n/g, '<br>'))\n  .join(separateur);\n\n// Un seul item en sortie : un seul e-mail\nreturn [{\n  json: {\n    html: `<div style=\"font-family:Arial, sans-serif; font-size:15px; line-height:1.5; max-width:680px\">${corps}</div>`\n  }\n}];\n"
