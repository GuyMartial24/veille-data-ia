    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT a.id, s.nom AS source, a.titre, left(a.contenu, 6000) AS contenu\nFROM annonces a\nJOIN sources s ON s.id = a.source_id\nWHERE a.resume IS NULL\n  AND a.envoyee_le IS NULL\n  AND length(coalesce(a.contenu, '')) >= 200\nORDER BY a.id;\n",
        "options": {}
