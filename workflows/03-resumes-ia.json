      "parameters": {
        "method": "POST",
        "url": "={{ $env.OLLAMA_URL }}/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: $env.OLLAMA_MODEL,\n  stream: false,\n  options: { temperature: 0.2, num_ctx: 4096 },\n  format: {\n    type: \"object\",\n    properties: { resume: { type: \"string\" }, notion_a_retenir: { type: \"string\" } },\n    required: [\"resume\", \"notion_a_retenir\"]\n  },\n  messages: [\n    { role: \"system\", content: `Tu es l'assistant de veille technique d'un data engineer francophone qui veut monter en compétence.\nOn te donne une annonce (nouvelle version d'un logiciel ou article de blog), souvent en anglais.\nRéponds en français, au format JSON demandé :\n- \"resume\" : 2 ou 3 phrases, sans introduction, qui disent ce que l'annonce apporte de nouveau. Utilise uniquement les informations présentes dans le texte, n'invente rien.\n- \"notion_a_retenir\" : 1 ou 2 phrases qui expliquent simplement UNE notion technique citée dans l'annonce (ce que c'est et à quoi ça sert), pour quelqu'un qui apprend. Commence par le nom de la notion.\nSi le texte ne contient pas assez d'information, écris \"Pas de détail dans l'annonce.\" dans \"resume\".` },\n    { role: \"user\", content: \"Source : \" + $json.source + \"\\nTitre : \" + $json.titre + \"\\n\\nTexte :\\n\" + $json.contenu }\n  ]\n}) }}\n",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1
            }
          },
          "timeout": 600000
        }
      },
