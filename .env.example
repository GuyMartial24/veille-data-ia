# Modèle du fichier .env
# Copier ce fichier en .env, puis remplacer chaque valeur « a_remplacer ».
# Le fichier .env n'est jamais versionné (voir .gitignore).

# ----- PostgreSQL -----
POSTGRES_USER=veille
POSTGRES_PASSWORD=a_remplacer

# ----- n8n -----
# Clé de chiffrement des identifiants : à générer une fois, puis à conserver précieusement
N8N_ENCRYPTION_KEY=a_remplacer

# ----- Ollama -----
# Ollama tourne sur la machine hôte, hors de Docker
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# ----- Telegram -----
# Identifiant de la conversation qui reçoit le digest (voir getUpdates)
# Le token du bot n'est PAS ici : il est enregistré comme credential dans n8n
TELEGRAM_CHAT_ID=a_remplacer

# ----- E-mail -----
# Adresse qui reçoit le digest
# Le mot de passe d'application Gmail n'est PAS ici : il est enregistré comme credential SMTP dans n8n
EMAIL_DESTINATAIRE=a_remplacer
